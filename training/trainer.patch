+def num_speakers(voice_onnx) -> int:
+    """Speakers in a Piper voice (1 for most; libritts_r has 904, vctk 109)."""
+    key = str(voice_onnx)
+    if key not in _NUM_SPEAKERS:
+        try:
+            with open(key + ".json", encoding="utf-8") as f:
+                _NUM_SPEAKERS[key] = int(json.load(f).get("num_speakers", 1))
+        except Exception:
+            _NUM_SPEAKERS[key] = 1
+    return _NUM_SPEAKERS[key]
