+def release_memory() -> None:
+    """Hand freed heap back to the OS. Feature extraction builds lists of
+    hundreds of thousands of small arrays; after they are freed glibc keeps the
+    pages, and on a 16 GB machine that retained heap is what gets the negative
+    half of the features phase OOM-killed."""
+    import ctypes
+    import gc
+    gc.collect()
+    try:
+        ctypes.CDLL("libc.so.6").malloc_trim(0)
+    except Exception:
+        pass
+
